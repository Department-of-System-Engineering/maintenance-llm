# Másold le .env néven, és töltsd ki a saját értékeiddel. A .env nem kerül a repóba.

# --- Ollama (config/settings.py) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
SEARCH_MODEL=snowflake-arctic-embed2

# --- MSSQL kapcsolatok (src/db/db_connector.py) ---
# Helyi SQL Server, Windows-hitelesítéssel (a scripts/generate_synthetic_data.py ezeket az adatbázisokat hozza létre):
#   mssql+pyodbc://@localhost/ICMMS_INT_DEV?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
MSSQL_URI_PTSP=
MSSQL_URI_INTP=
MSSQL_URI_AI_REPORTING=
MSSQL_URI_ICMMS_INT=
MSSQL_URI_LLM_DEV=
